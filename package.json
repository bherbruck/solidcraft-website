{
  "name": "solidcraft-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @solidcraft/solidcraft-landing run dev",
    "typecheck": "pnpm --filter @solidcraft/solidcraft-landing run typecheck",
    "test:unit": "pnpm --filter @solidcraft/solidcraft-landing run test:unit",
    "content:validate": "pnpm --filter @solidcraft/solidcraft-landing run content:validate",
    "build": "pnpm --filter @solidcraft/solidcraft-landing run build",
    "test:output": "pnpm --filter @solidcraft/solidcraft-landing run test:output",
    "test:e2e": "pnpm --filter @solidcraft/solidcraft-landing run test:e2e",
    "test:dev": "pnpm --filter @solidcraft/solidcraft-landing run test:dev",
    "preview": "pnpm --filter @solidcraft/solidcraft-landing run preview",
    "releases:refresh": "pnpm --filter @solidcraft/solidcraft-landing run releases:refresh"
  }
}
