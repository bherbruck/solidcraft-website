---
import Icon from './Icon.astro';
---

<div class="showcase-grid">
  <a class="showcase-card" href="/showcase/pi-enclosure/"
    ><img
      src="/media/enclosure-poster.jpg"
      alt="A teal Raspberry Pi enclosure with port cutouts, vents, and internal standoffs in the SolidCraft editor"
      width="1600"
      height="900"
      loading="lazy"
    ><div class="card-meta"
      ><div
        ><p class="eyebrow">PARAMETRIC MODELING · SOLIDCRAFT CONTRIBUTORS</p
        ><h3>Raspberry Pi enclosure.</h3
        ><p>Sketch, model, and resize an enclosure with named parameters.</p></div
      ><Icon name="external" /></div
    ></a
  >
  <a class="showcase-card" href="/showcase/selene/"
    ><img
      src="/media/rover-poster.jpg"
      alt="The SELENE scientific rover assembly in the SolidCraft editor"
      width="1600"
      height="900"
      loading="lazy"
    ><div class="card-meta"
      ><div
        ><p class="eyebrow">AGENT WORKFLOW · 0XLILLITH</p><h3>Meet SELENE.</h3
        ><p>A scientific rover modeled through SolidCraft’s MCP server.</p></div
      ><Icon name="external" /></div
    ></a
  >
</div>
