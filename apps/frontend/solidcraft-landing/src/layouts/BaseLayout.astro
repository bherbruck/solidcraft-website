---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title: string; description: string; class?: string; }
const { title, description, class: pageClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://solidcraft.io').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#181c24" />
    <meta property="og:type" content="website" /><meta property="og:site_name" content="SolidCraft" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://solidcraft.io/brand/social-banner.png" /><meta property="og:image:width" content="1280" /><meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="SolidCraft — open-source parametric CAD" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header /><main id="main" tabindex="-1"><slot /></main><Footer />
  </body>
</html>
