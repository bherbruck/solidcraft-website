---
import ClosingCTA from '../../components/ClosingCTA.astro';
import ShowcaseCards from '../../components/ShowcaseCards.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Made with SolidCraft · Example models"
  description="Watch a parametric enclosure demo and the SELENE rover timeline replay, with model sources and recording details."
>
  <section class="page-intro container"
    ><p class="eyebrow">EXAMPLE MODELS</p><h1>Made with SolidCraft.</h1
    ><p class="lead"
      >Watch an enclosure being modeled and a rover’s feature history being replayed. Each example
      includes source links and recording details.</p
    ></section
  >
  <section class="container" style="padding-bottom:80px"
    ><h2 class="sr-only">Model stories</h2><ShowcaseCards />
    <p class="small muted" style="margin-top:32px"
      >These examples demonstrate modeling workflows. They are not presented as manufactured or
      independently validated designs.</p
    ></section
  ><ClosingCTA />
</BaseLayout>
