---
import Icon from "../../../components/Icon.astro";
import ProgressReport from "../../../components/ProgressReport";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { ProgressPage } from "../../../lib/progress-routes";
import { progressPages } from "../../../lib/progress-routes";
import "../../../styles/progress.css";
export function getStaticPaths() {
	return progressPages.map((page) => ({
		params: {
			report:
				page.path.slice("/solidcore/progress/".length).replace(/\/$/, "") ||
				undefined,
		},
		props: { page },
	}));
}
interface Props {
	page: ProgressPage;
}
const { page } = Astro.props;
const tabs = [
	{ label: "Overview", kind: "overview", href: "/solidcore/progress/" },
	{ label: "Units", kind: "units", href: "/solidcore/progress/units/" },
	{
		label: "Upstream issues",
		kind: "issues",
		href: "/solidcore/progress/issues/",
	},
	{ label: "SSI corpus", kind: "ssi", href: "/solidcore/progress/ssi/" },
];
---

<BaseLayout
	class="progress-page"
	description="Live SolidCore port progress, unit-level test results, upstream issues, and surface-intersection tests."
	title={`${page.heading} · SolidCraft`}
>
	<div class="progress-bar">
		<div class="container progress-bar-inner">
			<a class="progress-back" href="/solidcore/">
				<Icon name="arrow" size={16} /> SolidCore
			</a>
			<nav aria-label="Progress navigation">
				{tabs.map((tab) => (
					<a
						aria-current={
							(
								page.kind === "unit"
									? tab.kind === "units"
									: page.kind === tab.kind
							)
								? "page"
								: undefined
						}
						href={tab.href}
					>
						{tab.label}
					</a>
				))}
			</nav>
			<a
				class="progress-repository"
				href="https://github.com/tangency-labs/solidcore"
			>
				Repository<Icon name="external" size={16} />
			</a>
		</div>
	</div>
	<div class="container progress-report">
		<ProgressReport page={page} client:load />
	</div>
</BaseLayout>
