---
import ClosingCTA from "../components/ClosingCTA.astro";
import CodeBlock from "../components/CodeBlock";
import Icon from "../components/Icon.astro";
import Video from "../components/Video.astro";
import { guide, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	description="Connect a compatible AI agent to SolidCraft’s local MCP server. Learn headless and desktop modes, model inspection, setup, and file permissions."
	title="MCP & AI-agent workflows · SolidCraft"
>
	<section class="page-intro container intro-grid">
		<div>
			<p class="eyebrow">AI AGENTS / MCP AND CLI</p>
			<h1>Connect an AI agent<br>to SolidCraft.</h1>
			<p class="lead">
				SolidCraft’s local Model Context Protocol (MCP) server lets compatible
				AI agents run modeling commands, inspect geometry, and edit designs.
			</p>
			<div class="actions">
				<a class="button primary" href="#setup">Set up MCP<Icon size={18} /></a>
				<a class="text-link" href="/download/#cli">
					Download the CLI<Icon name="download" size={18} />
				</a>
			</div>
		</div>
		<div>
			<Video model="rover" />
			<p class="small muted" style="margin-top:14px">
				SELENE by 0xlillith. Built through SolidCraft MCP; the video replays the
				model’s feature history.
			</p>
		</div>
	</section>
	<nav aria-label="MCP sections" class="subnav">
		<div class="container">
			<a href="#workflow">The workflow</a>
			<a href="#tools">The tools</a>
			<a href="#modes">Operating modes</a>
			<a href="#setup">Setup</a>
			<a href="#permissions">Permissions</a>
		</div>
	</nav>
	<section class="section section-alt" id="workflow">
		<div class="container">
			<div class="section-heading">
				<div>
					<p class="eyebrow">HOW IT WORKS</p>
					<h2>Build. Inspect. Revise. Check.</h2>
				</div>
				<a class="text-link" href="/showcase/selene/">
					View the SELENE model<Icon size={18} />
				</a>
			</div>
			<p class="lead">
				An agent uses the same command engine as the editor. It can change the
				model, inspect the result, and use that feedback to make another change.
			</p>
			<div class="process">
				<div>
					<span class="mono">01 / BUILD</span>
					<h3>Create features.</h3>
					<p>Create geometry and features through the command interface.</p>
				</div>
				<div>
					<span class="mono">02 / INSPECT</span>
					<h3>Inspect geometry.</h3>
					<p>Read parameters, measure geometry, and request a screenshot.</p>
				</div>
				<div>
					<span class="mono">03 / REVISE</span>
					<h3>Edit parameters.</h3>
					<p>
						Adjust a parameter or operation while retaining the design history.
					</p>
				</div>
				<div>
					<span class="mono">04 / CHECK</span>
					<h3>Check the result.</h3>
					<p>
						Inspect the result before saving, exporting, or making another
						change.
					</p>
				</div>
			</div>
		</div>
	</section>
	<section class="section" id="tools">
		<div class="container">
			<p class="eyebrow">MCP TOOLS</p>
			<h2>Available commands.</h2>
			<div
				aria-label="Selected MCP tool categories"
				class="format-table-wrapper"
				role="region"
				tabindex="0"
			>
				<table>
					<thead>
						<tr>
							<th scope="col">Task</th>
							<th scope="col">Selected tools</th>
							<th scope="col">What they do</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<th scope="row">Discover</th>
							<td><code>list_commands</code></td>
							<td>Find available operations and their arguments.</td>
						</tr>
						<tr>
							<th scope="row">Model</th>
							<td><code>execute · batch · set_parameter</code></td>
							<td>Run commands and revise values.</td>
						</tr>
						<tr>
							<th scope="row">Inspect</th>
							<td><code>inspect_design · measure · body_topology</code></td>
							<td>Examine design state, measurements, and geometry.</td>
						</tr>
						<tr>
							<th scope="row">View</th>
							<td><code>screenshot</code></td>
							<td>Obtain an image of the result.</td>
						</tr>
						<tr>
							<th scope="row">Continue</th>
							<td><code>undo · redo · open · save · export</code></td>
							<td>Work with history and design files.</td>
						</tr>
					</tbody>
				</table>
			</div>
			<a class="text-link" href={guide("mcp")} style="margin-top:24px">
				MCP tool reference<Icon name="external" size={18} />
			</a>
		</div>
	</section>
	<section class="section" id="modes" style="padding-top:0">
		<div class="container">
			<p class="eyebrow">LOCAL STDIO SERVER</p>
			<h2>Headless, or alongside the app.</h2>
			<div class="two-column" style="margin-top:36px">
				<div class="mode">
					<p class="eyebrow">01 / HEADLESS</p>
					<h3>A design session without a window.</h3>
					<p>
						Use the CLI for scripted modeling, measurement, export, and
						screenshots rendered on the CPU.
					</p>
					<CodeBlock
						command="solidcraft-cli mcp"
						label="START A HEADLESS SESSION"
						client:load
					/>
				</div>
				<div class="mode">
					<p class="eyebrow">02 / DESKTOP CONNECTED</p>
					<h3>Watch the agent work.</h3>
					<p>
						Start the desktop app’s control channel, then connect the MCP server
						on the same machine.
					</p>
					<CodeBlock
						command={"solidcraft --control 7878\nsolidcraft-cli mcp --connect 127.0.0.1:7878"}
						label="RUN IN TWO TERMINALS"
						client:load
					/>
				</div>
			</div>
			<p class="small muted" style="margin-top:20px">
				Desktop MCP is the documented reference implementation. Browser-agent
				sessions are not offered by this website.
			</p>
		</div>
	</section>
	<section class="section section-alt" id="setup">
		<div class="container story-grid">
			<div>
				<p class="eyebrow">SETUP</p>
				<h2>Configure your MCP client.</h2>
				<p class="lead">
					Install the CLI for your system and make<code>
						solidcraft-cli
					</code> available on your PATH. Then follow the configuration guide
					for a client that supports MCP over stdio.
				</p>
				<a class="text-link" href={guide("mcp")}>
					MCP setup guide<Icon name="external" size={18} />
				</a>
			</div>
			<div>
				<h3>Using Claude Code</h3>
				<p class="muted" style="margin-top:18px">
					With Claude Code and the SolidCraft CLI installed, add the local
					server:
				</p>
				<CodeBlock
					command="claude mcp add solidcraft -- solidcraft-cli mcp"
					label="CLAUDE CODE"
					client:load
				/>
				<p class="small muted">
					This registers the MCP server in Claude Code. Install the SolidCraft
					CLI first. See the setup guide for other clients and troubleshooting.
				</p>
			</div>
		</div>
	</section>
	<section class="section" id="permissions">
		<div class="container story-grid">
			<div>
				<p class="eyebrow">REVIEW WHAT THE AGENT CAN ACCESS</p>
				<h2>File access and<br>AI provider settings.</h2>
				<p class="lead">
					Review agent-assisted changes as you would any design change.
					Understand the connection, file scope, and your AI provider’s data
					handling.
				</p>
			</div>
			<div class="prose">
				<h3>Allowed folders.</h3>
				<p>
					The server documents which design, recovery, scratch, and explicitly
					allowed folders its tools can access. Additional paths require
					explicit configuration. Read the exact file-access rules before
					granting access.
				</p>
				<h3>Data sent to your AI provider.</h3>
				<p>
					The MCP server runs on your machine, but your AI client may send
					prompts, tool output, and screenshots to its provider. Check your
					client’s privacy settings.
				</p>
				<a class="text-link" href={guide("mcp")}>
					Permissions & troubleshooting<Icon name="external" size={18} />
				</a>
			</div>
		</div>
	</section>
	<section class="container" style="padding-bottom:80px">
		<div class="notice">
			<strong>Example models and scripts.</strong>
			<br>
			Inspect
			<a href="/showcase/selene/">SELENE’s source model and timeline replay</a>
			, or start with the
			<a href={`${site.repo}/blob/main/examples/bracket.json`}>
				maintained bracket command script
			</a>
			. Open the model or run the script in SolidCraft to inspect the features.
		</div>
	</section>
	<ClosingCTA />
</BaseLayout>
